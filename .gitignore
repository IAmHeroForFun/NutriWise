# ==============================================================================
# NutriWise — Git Ignore File (.gitignore)
# Ensures private secrets, credentials, databases, and local assets stay private.
# ==============================================================================

# Environment variable files (SECRETS & API KEYS)
.env
.env.*
!.env.example
!.env.production.example

# Local SQLite Database & backups
*.sqlite3
*.sqlite3-journal
db.sqlite3
/data/
/db_data/
backups/

# Python Virtual Environments & Packages
venv/
.venv/
env/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Byte-compiled / optimized files
__pycache__/
*.py[cod]
*$py.class

# Static & Media Uploads
/staticfiles/
/media/
/media/documents/*
!/media/documents/.gitkeep

# SSL & Security Certificates / Private Keys
*.pem
*.key
*.crt
*.csr
/nginx/ssl/
/certbot/

# Operating System & IDE Artifacts
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*~

# Logs & Runtime Dumps
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
