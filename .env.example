# ==============================================================================
# NutriWise — Local Development Environment Configuration (.env.example)
# Copy this file to .env and replace the placeholder values:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# Django Core Settings
# ------------------------------------------------------------------------------
# Generate a unique secret key for your environment.
SECRET_KEY=django-insecure-local-dev-key-change-in-production-12345

# Set to True for local development; NEVER set to True in production
DEBUG=True

# Comma-separated list of allowed hostnames/IPs
ALLOWED_HOSTS=*

# Comma-separated list of trusted origins for CSRF (e.g., http://localhost:8000)
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# ------------------------------------------------------------------------------
# External API Keys
# ------------------------------------------------------------------------------
# OpenWeather API Key (Free tier from https://openweathermap.org/api)
# Used to fetch live ambient temperature and classify weather into thermal categories
OPENWEATHER_API_KEY=your_openweather_api_key_here

# Google Gemini API Key (Free tier from https://aistudio.google.com/)
# Used for source-grounded meal curation and autonomous knowledge distillation
GEMINI_API_KEY=your_gemini_api_key_here

# Primary Gemini Model to invoke (fallback sequence will automatically handle 503/404)
# Options: gemini-3.6-flash, gemini-3.5-flash, gemini-flash-latest, gemini-2.5-flash-lite
GEMINI_MODEL=gemini-3.6-flash

# ------------------------------------------------------------------------------
# Database Settings (Optional)
# ------------------------------------------------------------------------------
# Leave DB_HOST blank to automatically use local SQLite database (db.sqlite3)
# To use PostgreSQL (e.g. Supabase or local Postgres), fill in the fields below:
DB_HOST=
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=your_database_password_here
