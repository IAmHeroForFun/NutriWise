# ==============================================================================
# NutriWise — Production Environment Configuration (.env.production.example)
# Use this configuration template for AWS Lightsail, Docker, or Cloud deployments:
#   cp .env.production.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# Security Settings (CRITICAL)
# ------------------------------------------------------------------------------
# Generate a strong, random 50+ character secret key.
# Python command to generate: python -c 'import secrets; print(secrets.token_urlsafe(50))'
SECRET_KEY=replace-with-a-very-long-random-secret-key-in-production-do-not-share

# MUST be False in production to prevent leaking sensitive tracebacks to users
DEBUG=False

# Comma-separated list of your production domain names and server public IPs
# Example: yourdomain.com,www.yourdomain.com,13.235.12.34
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com,YOUR_LIGHTSAIL_STATIC_IP

# Comma-separated list of full HTTPS URLs for CSRF protection
# Example: https://yourdomain.com,https://www.yourdomain.com
CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# ------------------------------------------------------------------------------
# Production APIs
# ------------------------------------------------------------------------------
# OpenWeather API Key (https://openweathermap.org/api)
OPENWEATHER_API_KEY=your_production_openweather_api_key

# Google Gemini API Key (https://aistudio.google.com/)
GEMINI_API_KEY=your_production_gemini_api_key
GEMINI_MODEL=gemini-3.6-flash

# ------------------------------------------------------------------------------
# Database Settings
# ------------------------------------------------------------------------------
# Option A: To use local persistent SQLite inside Docker volume (Zero setup):
# Leave DB_HOST blank. Data persists in Docker volume 'db_data'.
DB_HOST=

# Option B: To connect to Supabase PostgreSQL or Amazon RDS:
# DB_HOST=db.xxxxxxxxxxxx.supabase.co
# DB_PORT=5432
# DB_NAME=postgres
# DB_USER=postgres
# DB_PASSWORD=your_secure_database_password
